# API REST de RedTransporteAPI (https://api.example.com por defecto)
RED_TRANSPORTE_API_URL=https://api.example.com

# Token de API creado en POST /admin/tokens (master token de la API)
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
RED_TRANSPORTE_API_TOKEN=

# Token privado usado por clientes legacy y como credencial para autorizar el flujo OAuth.
# No se expone al upstream ni a las tools.
RED_TRANSPORTE_MCP_TOKEN=

# Hostname público permitido por la protección DNS-rebinding del transporte HTTP.
# Cambiarlo si se despliega detrás de otro hostname.
# RED_TRANSPORTE_MCP_PUBLIC_HOST=mcp.example.com

# URL canónica del recurso MCP para OAuth (incluye /mcp).
# RED_TRANSPORTE_MCP_BASE_URL=https://mcp.example.com

# Opcional: secreto HMAC separado para clientes registrados y tokens OAuth.
# Si se omite, se deriva del MCP token.
# RED_TRANSPORTE_OAUTH_SECRET=

# RED_TRANSPORTE_MCP_PORT=8001
# RED_TRANSPORTE_MCP_TIMEOUT=30
